# 阿里云百炼 API Key
# 复制此文件为 .env 并填入你的真实 API Key
DASHSCOPE_API_KEY=sk-your-key-here
# 默认使用公共兼容模式 endpoint；
# 若是 MaaS workspace 地址（ws-xxx.cn-beijing.maas.aliyuncs.com），
# 请使用 /compatible-mode/v1 路径，/api/v1 只支持模型列表等非 OpenAI 兼容接口。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 多模态 OCR 开关：true=启用 SmartPerceptionPipeline（本地预判+qwen3.5-flash 兜底）
# false=回退到纯本地 VisionPipeline
USE_MULTIMODAL_OCR=true

# WeFlow 可选模式。使用时请配置随机 token；默认 token 仅适合本机回环地址。
# WEFLOW_ACCESS_TOKEN=replace-with-a-random-token

# 静默模式下，非白名单消息会被标记为已处理；关闭静默后不会补回复。
# WECHAT_SILENT_MODE=0
# SILENT_WHITELIST=文件传输助手

# 管理后台代码审计使用的 Kimi CLI（可选）
# KIMI_BIN=/Users/your-name/.local/bin/kimi

# 本人真实聊天 few-shot（含私密数据，人工审核 report.json 后再启用）
# ENABLE_PERSONA_FEW_SHOTS=0
# PERSONA_FEW_SHOT_COUNT=8
# PERSONA_FEW_SHOT_MAX_CHARS=2500
# PERSONA_FEW_SHOT_PATH=data/few_shot/persona_examples.jsonl
# 仅限本地临时调试，生产不要绕过人工审核
# PERSONA_FEW_SHOT_ALLOW_UNREVIEWED=0

# Tuya 涂鸦智能家居 API 凭证（可选）
# 在 https://iot.tuya.com/ 创建项目后获取
# TUYA_ACCESS_ID=your_access_id
# TUYA_ACCESS_SECRET=your_access_secret
# TUYA_ENDPOINT=https://openapi.tuyacn.com
# TUYA_UID=your_uid

# Tuya 控制模式：cloud（云API）/ local（局域网）/ auto（优先本地，失败回退云端）
# TUYA_MODE=auto
