  "judge_protocol": {
    "task": "anonymous human-versus-bot authorship discrimination from complete chat context",
    "one_case_per_fresh_api_call": true,
    "tools": "none for authorship Judge; fact and boundary verification is a separate evaluator",
    "option_order": "balanced canonical and swapped calls",
    "forbidden_inputs": [
      "answer key",
      "candidate identity or model name",
      "generation trace",
      "other cases",
      "Codex thread history",
      "filesystem access"
    ],
    "audit": [
      "raw prompt",
      "complete supplied context",
      "raw candidate replies",
      "raw output",
      "model and parameters",
      "tool-call count"
    ],
    "engineering_gate": {
      "required_test_sets": 2,
      "cases_per_test_set_min": 100,
      "overall_accuracy_min_each": 0.85,
      "complex_group_accuracy_min_each": 0.80,
      "ordinary_group_accuracy_min_each": 0.80,
      "high_confidence_error_rate_max_each": 0.03,
      "position_consistency_min": 0.90,
      "surface_cue_dependency_rejects_candidate": true,
      "obvious_length_position_or_topic_attribution_bias_rejects_candidate": true
    }
  },
  "bot_protocol": {
    "candidate_origin": "independent candidate from protected C0",
    "one_variable_per_round": true,
    "first_hypotheses": [
      "same-chat human style example selection",
      "stable style and humor abstraction without copying facts or consumed jokes",
      "RAG as an isolated comparison arm",
      "model change as an isolated comparison arm with latency and reliability gates"
    ],
    "promotion_requires": {
      "human_full_context_ab": {
        "two_sided_sign_test_p_max": 0.05,
        "net_win_rate_improvement_min_points": 10,
        "wins_must_exceed_losses": true
      },
      "complex_large_group": {
        "must_not_regress": true,
        "net_wins_must_be_positive": true
      },
      "private_chat_regression": "no_material_regression",
      "new_factual_hallucinations_max": 0,
      "new_real_world_action_commitments_max": 0,
      "must_not_worsen": [
        "stale jokes",
        "cross-turn repetition",
        "generation failures",
        "P95 latency"
      ],
      "forbidden_shortcuts": [
        "longer replies",
        "more frequent interjections"
      ],
      "final_unused_hidden_cases_min": 100
    },
    "judge_confusion_alone_is_quality_evidence": false
  },
  "alternation": [
    "freeze C0; use development only to improve Judge candidates",
    "use fixed validation aggregate metrics to select one Judge candidate",
    "open sealed test_a and test_b only for Judge freeze acceptance",
    "freeze accepted Judge; test one C0 improvement hypothesis",
    "after the Bot round, add reviewed hard cases only to the next development pool, never retroactively to sealed tests"
  ],
  "anti_gaming": {
    "hidden_in_prompt_rag_wiki_or_fewshot": false,
    "hidden_case_level_feedback": false,
    "judge_and_bot_changed_in_same_round": false,
    "keep_frozen_old_judge_for_regression": true,
    "human_case_review_is_final_authority": true,
    "stop_after_two_failed_candidates_for_same_hypothesis": true
  },
  "production_alignment": {
    "required": true,
    "differences_require_user_confirmation_before_run": true,
    "checklist": [
      "GlobalStore and unread-message state",
      "current Wiki and historical-time leakage",
      "context window and timestamps",
      "model and sampling parameters",
      "tools and their returned evidence",
      "few-shot and RAG inputs",
      "self-refine, fact-check, reply decision and message splitting"
    ]
  },
  "reporting": {
    "format": "mobile-friendly HTML",
    "case_fields": [
      "complete chat context",
      "verified human original when available",
      "C0 and candidate raw replies",
      "anonymous Judge choice and reason",
      "raw Judge prompt and call audit"
    ]
  }
